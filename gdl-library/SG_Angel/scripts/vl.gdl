! ============================================================================
!  SG エンジェル  ―― PARAMETER SCRIPT (vl.gdl)
!
!  ・実在する機種・段数のみを選べるようにする
!  ・派生値（外形寸法・数量・質量）は編集不可にする
! ============================================================================


! ---------------------------------------------------------------------------
!  機種
! ---------------------------------------------------------------------------
VALUES "iModel"	1, "SG エンジェル（天板 1500x1000）", \
				2, "SG エンジェル750（天板 1500x750）"

VALUES "iType"	1, "M タイプ（天板高 700-900 / 100x2段）", \
				2, "L タイプ（天板高 1075-1475 / 100x4段）"

! 天板高さ ―― タイプごとに実在する 100mm ピッチの段だけを提示する
if iType = 2 then
	VALUES "hDeck" 1.075, 1.175, 1.275, 1.375, 1.475
else
	VALUES "hDeck" 0.700, 0.800, 0.900
endif


! ---------------------------------------------------------------------------
!  連結
! ---------------------------------------------------------------------------
VALUES "nX" RANGE [1, 30] STEP 1, 1
VALUES "nY" RANGE [1, 30] STEP 1, 1
VALUES "gapX" RANGE [0, 5]
VALUES "gapY" RANGE [0, 5]

! 離れが無い（突き付け連結）ときはブリッジを架けられない
if nX <= 1 then LOCK "gapX"
if nY <= 1 then LOCK "gapY"
if nX <= 1 | gapX <= 0 then LOCK "bBridgeX"
if nY <= 1 | gapY <= 0 then LOCK "bBridgeY"


! ---------------------------------------------------------------------------
!  表示
! ---------------------------------------------------------------------------
VALUES "iLOD"	1, "簡易（配置検討・大量配置向け）", \
				2, "標準", \
				3, "詳細"

VALUES "txtSize" 1.5, 2.0, 2.5, 3.0, 4.0

if bShowFill = 0 then LOCK "fillDeck", "penFill", "bFillBk"
if bShowFill = 0 | bFillBk = 0 then LOCK "penFillBk"
if b2DLabel = 0 then LOCK "txtSize", "penText"
if b2DFootprint = 0 then LOCK "penFoot", "lineFoot"


! ---------------------------------------------------------------------------
!  派生値（編集不可 ―― 一覧表・積算用の読み取り専用）
! ---------------------------------------------------------------------------
LOCK "A", "B", "ZZYZX"
LOCK "sModelName", "sSpec", "nUnitOut", "rMassTotal", "rDeckArea", \
     "rLoadSingle", "rLoadPerSqm"
